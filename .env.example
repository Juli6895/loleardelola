# =========================================
# LolearDeLola - Variables de entorno
# =========================================
# Copia este archivo como `.env.local` y llena los valores.

# --- NextAuth ---
# Genera un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Pinterest OAuth ---
# Crea una app en https://developers.pinterest.com/apps/
# Redirect URI: http://localhost:3000/api/auth/callback/pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- Supabase ---
# Crea un proyecto en https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
# Analizador principal de outfits. Usa Claude Haiku 4.5 con visión multimodal
# para detectar prendas con mayor precisión que Vision API.
# Crea una API key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Cloud Vision (fallback) ---
# Se usa solo si Claude falla o no hay ANTHROPIC_API_KEY.
# Crea una API key en https://console.cloud.google.com/apis/credentials
# Habilita la Cloud Vision API (free tier: 1.000 imágenes/mes)
GOOGLE_CLOUD_VISION_API_KEY=

# --- Cloudinary ---
# Crea cuenta en https://cloudinary.com (free tier generoso)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
